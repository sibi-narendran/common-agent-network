{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "common-agent-network",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-07",
  "routes": [
    {
      "pattern": "agents.dooza.ai",
      "custom_domain": true,
    },
    {
      "pattern": "commons.dooza.ai",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  // Run the Worker near D1, not at the caller's edge: every request makes
  // several serial D1 queries (10-22: ~0.7 s each from a far edge).
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
  },
}
